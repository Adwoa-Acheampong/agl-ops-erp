# ───────────────────────────  AGL OPS · ENVIRONMENT  ───────────────────────────
# Copy this file to .env and fill in the values for your local setup.

# ── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
VITE_APP_ID=agl-ops

# ── Database (MySQL) ────────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local MySQL Workbench install:
DATABASE_URL=mysql://root:your_password@localhost:3306/agl_ops

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-48-bytes-of-randomness
OWNER_OPEN_ID=

# ── OAuth (legacy — leave blank for now) ────────────────────────────────────────
OAUTH_SERVER_URL=

# ── Forge / built-in (legacy — leave blank for now) ─────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Anthropic (FixBot) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── WhatsApp Cloud API (Reminders) ──────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Excel data file (legacy import path; optional) ──────────────────────────────
EXCEL_FILE_PATH=

# ── Master-data importer (only when running scripts/import-master-data.mjs) ─────
INVENTORY_XLSX=
MASTER_XLSX=

# ── Operations ──────────────────────────────────────────────────────────────────
# IANA tz used for payroll late-arrival check + day boundaries.
TENANT_TIMEZONE=Africa/Accra

# Graceful-shutdown grace window in ms before force-exit (default 10000).
SHUTDOWN_GRACE_MS=10000

# Sentry-compatible error reporter DSN; if blank, reportError() is a no-op.
ERROR_DSN=

# Bypass boot-time Zod env validation. Test/tooling only — never set in prod.
SKIP_ENV_VALIDATION=

# ── P23 — AGL_Ops domain integrations ─────────────────────────────────────────
# Paystack secret. Without this, the cashier UI hides the "Pay with Paystack"
# button and `paystack.initialize` returns NOT_IMPLEMENTED.
PAYSTACK_SECRET_KEY=

# Bearer token expected on /api/bot/slash. n8n / WhatsApp relays must POST
# `Authorization: Bearer ${BOT_WEBHOOK_SECRET}` to authenticate. If unset, the
# webhook returns 503 so an unconfigured environment can't be impersonated.
BOT_WEBHOOK_SECRET=
